programa {
    funcao inicio() {
        real nota
        
        escreva("Qual a nota do aluno: ")
        leia(nota)
        
        se (nota >= 7) {
            escreva("Você foi aprovado! Parabéns pelo esforço e dedicação!")
        } senao {
            escreva("Você foi reprovado. estude mais que com certeza vai ser aprovado e ficar muito feliz!")
        }
    }
}
            